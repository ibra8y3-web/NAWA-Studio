{
  "scopeName": "source.nawa",
  "name": "NawaScript",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nawa",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nawa",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nawa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nawa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nawa",
          "match": "\\b(app|screen|state|text|button|input|switch|checkbox|slider|if|else|repeat|while|fun|navigate|at)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nawa",
          "match": "\\b(Int|String|Bool|Boolean)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.nawa",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nawa",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nawa",
          "match": "(==|!=|<=|>=|&&|\\|\\||[=+!<>-])"
        }
      ]
    }
  }
}
